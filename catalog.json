      "bindings": [
        {
          "type": "kv",
          "name": "MY_KV",
          "title": "demo-kv",
          "action": "create-or-reuse"
        }
      ]
    },
    {
      "id": "d1-demo",
      "name": "D1 数据库演示",
      "description": "演示 Worker + D1 数据库的完整 CRUD 操作。自动创建 items 表，支持增删查。",
      "author": {
        "name": "CF Manager"
      },
      "version": "1.0.0",
      "tags": [
        "d1",
        "数据库",
        "worker",
        "CRUD"
      ],
      "type": "worker",
      "source": {
        "kind": "raw",
        "url": "https://raw.githubusercontent.com/hefy2027/cf-store/main/templates/d1-demo/worker.js"
      },
      "bindings": [
        {
          "type": "d1",
          "name": "MY_DB",
          "title": "demo-db",
          "action": "create-or-reuse",
          "initSql": "CREATE TABLE IF NOT EXISTS items (id INTEGER PRIMARY KEY AUTOINCREMENT, title TEXT NOT NULL, content TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)"
        }
      ]
    },
