    {
      "id": "edgetunnel",
      "name": "EdgeTunnel (VLESS/Trojan/SS)",
      "description": "基于 Cloudflare Workers/Pages 的边缘隧道面板，支持 VLESS、Trojan、Shadowsocks 协议，内置管理后台与订阅系统。第三方开源项目（cmliu/edgetunnel）。",
      "author": {
        "name": "cmliu",
        "url": "https://github.com/cmliu/edgetunnel"
      },
      "version": "2.1.0",
      "tags": [
        "隧道",
        "代理",
        "worker",
        "pages",
        "hybrid",
        "第三方"
      ],
      "type": "hybrid",
      "sources": {
        "worker": {
          "kind": "raw",
          "url": "https://raw.githubusercontent.com/cmliu/edgetunnel/main/_worker.js"
        },
        "pages": {
          "kind": "repo-archive",
          "url": "https://github.com/cmliu/edgetunnel/archive/refs/heads/main.zip"
        }
      },
      "bindings": [
        {
          "type": "kv",
          "name": "KV",
          "title": "edgetunnel-kv",
          "action": "create-or-reuse"
        },
        {
          "name": "ADMIN",
          "type": "var",
          "action": "prompt",
          "required": false,
          "title": "管理后台密码（可选）",
          "secret": true
        },
        {
          "name": "UUID",
          "type": "var",
          "action": "prompt",
          "required": false,
          "title": "VLESS 用户 UUID（标准 UUID 格式，留空使用默认）",
          "secret": false
        }
      ],
      "env": {}
    }
  ]
}
